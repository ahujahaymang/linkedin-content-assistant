# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Provider Configuration
# Primary provider: bedrock_claude, openai, or anthropic
LLM_PRIMARY_PROVIDER=bedrock_claude
LLM_PRIMARY_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# AWS Configuration (for Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# OpenAI Configuration (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration (optional fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# System Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Data Directories
DATA_DIR=./data
PROFILES_DIR=./profiles
CONFIG_FILE=./config/config.yaml
